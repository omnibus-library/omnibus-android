<?xml version="1.0" encoding="utf-8"?>
<!-- Series Details (docs/features/series-details.md) -->
<resources>
    <!-- The page's loading label. -->
    <string name="series_details_loading">Loading</string>
    <!-- The count line under the top bar. %1$s is the author, %2$s the book count such as "7 books". -->
    <string name="series_details_count_line">%1$s · %2$s</string>
    <!-- The count line's book count. -->
    <plurals name="series_details_book_count">
        <item quantity="one">%d book</item>
        <item quantity="other">%d books</item>
    </plurals>
    <!-- Placeholder row for one missing number. %1$d is the number. -->
    <string name="series_details_missing_one">Book %1$d</string>
    <!-- Placeholder row for a run of missing numbers. %1$d is the first number, %2$d the last. -->
    <string name="series_details_missing_range">Books %1$d–%2$d</string>
    <!-- Subtitle of a placeholder row. -->
    <string name="series_details_missing_subtitle">Missing from this series</string>
    <!-- The number column of a book with no series number. -->
    <string name="series_details_no_number">—</string>
    <!-- The empty state for a series with no books in the library. -->
    <string name="series_details_empty_title">No books here</string>
    <!-- The empty state's body. %1$s is the series name. -->
    <string name="series_details_empty_body">No books in your library are in "%1$s".</string>
    <!-- The state for a series the server no longer has. -->
    <string name="series_details_not_found_title">Series not found</string>
    <string name="series_details_not_found_body">This series isn\'t in your library any more.</string>
    <!-- The state when the server cannot be reached. -->
    <string name="series_details_unreachable_title">Can\'t reach your server</string>
    <string name="series_details_unreachable_body">Check your connection, then try again.</string>
    <!-- The state when the series could not be loaded for another reason. -->
    <string name="series_details_went_wrong_title">Series isn\'t loading</string>
    <string name="series_details_went_wrong_body">Your server couldn\'t load this series. Try again in a moment.</string>
    <!-- The error states' button. -->
    <string name="series_details_try_again">Try again</string>
    <!-- The snackbar action that refreshes again after a failed refresh. -->
    <string name="series_details_retry">Retry</string>
    <!-- The snackbar messages for a failed refresh that kept the books on screen. -->
    <string name="series_details_snackbar_unreachable">Can\'t reach your server</string>
    <string name="series_details_snackbar_went_wrong">Series isn\'t loading</string>
    <!-- What TalkBack reads for a book row without its number, after the title and authors. %1$s is the number. -->
    <string name="series_details_a11y_book_number">Book %1$s</string>
    <!-- What TalkBack reads for a single missing number. %1$d is the number. -->
    <string name="series_details_a11y_missing_one">Book %1$d, missing from this series</string>
    <!-- What TalkBack reads for a run of missing numbers. %1$d is the first number, %2$d the last. -->
    <string name="series_details_a11y_missing_range">Books %1$d to %2$d, missing from this series</string>
</resources>
