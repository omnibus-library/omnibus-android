<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- The cover cache is re-downloadable, so it stays out of backups and transfers. The auth keyset and token
         are unusable on another install: their Keystore master key is never backed up. -->
    <cloud-backup>
        <exclude domain="file" path="covers/"/>
        <exclude domain="sharedpref" path="omnibus_auth_keyset.xml"/>
        <exclude domain="file" path="datastore/auth_token.preferences_pb"/>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="covers/"/>
        <exclude domain="sharedpref" path="omnibus_auth_keyset.xml"/>
        <exclude domain="file" path="datastore/auth_token.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>